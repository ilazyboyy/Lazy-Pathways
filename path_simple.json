{
  "multipart": [
    {
      "when": {
        "state_render": 1,
        "stepped": false,
        "grass_north": false,
        "grass_south": false, 
        "grass_east": false,
        "grass_west": false
      },
      "apply": [
        { "model": "lazypathways:block/path_level_1", "y": 0 },
        { "model": "lazypathways:block/path_level_1", "y": 90 },
        { "model": "lazypathways:block/path_level_1", "y": 180 },
        { "model": "lazypathways:block/path_level_1", "y": 270 }
      ]
    },
    {
      "when": {
        "state_render": 1,
        "stepped": false,
        "grass_north": true,
        "grass_south": true,
        "grass_east": true,
        "grass_west": true
      },
      "apply": [
        { "model": "lazypathways:block/path_level_1_surrounded", "y": 0 },
        { "model": "lazypathways:block/path_level_1_surrounded", "y": 90 },
        { "model": "lazypathways:block/path_level_1_surrounded", "y": 180 },
        { "model": "lazypathways:block/path_level_1_surrounded", "y": 270 }
      ]
    }
  ]
}